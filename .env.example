# Copy to .env and fill in. .env is git-ignored.
# Any OpenAI-compatible chat endpoint works.
N2G_LLM_BASE_URL=
N2G_LLM_API_KEY=
N2G_MODEL_DEFAULT=
# Optional per-role overrides: EXTRACT, CONSOLIDATE, DIALOGUE, DIRECTOR, AUDIT, VISION
# N2G_MODEL_DIALOGUE=
# Optional JSON merged into every chat request body (vendor-specific switches go here).
# N2G_LLM_EXTRA_BODY={}
N2G_LLM_CONCURRENCY=8
# Optional extra HTTP headers (JSON) and a header carrying a per-run session id, for gateways that
# route or cache by session.
# N2G_LLM_HEADERS={}
# N2G_LLM_SESSION_HEADER=
# Safety limits. A request with no answer after N2G_LLM_REQUEST_TIMEOUT seconds is retried
# (default scales with max_tokens: 120 s + max_tokens/50). Progress prints to stderr every N seconds.
# N2G_LLM_REQUEST_TIMEOUT=
# N2G_PROGRESS_EVERY=30
# Spending cap in USD per command run (commands also take --budget). 0 means no cap.
# N2G_BUDGET_USD=0
# Price used to estimate cost when the gateway does not report it: input,output,cached-input USD per million tokens
# N2G_PRICE_PER_MTOK=
# Optional image generation service; art is optional, leave empty when no server is available
# N2G_IMAGE_URL=
# Optional local sentence-embedding model for ranking what a character remembers (⑥); BM25 is the default.
# Model files are downloaded once into N2G_EMBED_CACHE (default .cache/embed), vectors are cached in build/embed/.
# N2G_EMBED_MODEL=BAAI/bge-small-zh-v1.5
# N2G_EMBED_CACHE=.cache/embed
